{
  "name": "CookCap — A Family Cookbook",
  "short_name": "CookCap",
  "description": "CookCap — an interactive heirloom cookbook PWA. Name your book; flip pages; cook offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1a1512",
  "theme_color": "#1a1512",
  "categories": ["food", "lifestyle", "books"],
  "icons": [
    { "src": "./icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Search recipes",
      "short_name": "Search",
      "description": "Find a dish fast",
      "url": "./?open=search",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Shopping list",
      "short_name": "Shop",
      "url": "./?open=shop",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "This week",
      "short_name": "Plan",
      "url": "./?open=plan",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "./?share-target=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "./?restore=1",
      "accept": {
        "application/json": [".json"]
      }
    }
  ]
}
