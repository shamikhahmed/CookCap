  "steps": [
    {
      "instruction": "In wok,add beef bonless undercut,salt,red chili powder,turmeric powder,raw papaya paste and ginger garlic paste,mix well & marinate for 1 hour.",
      "romanUrdu": "Karhai mein beef boneless undercut,namak,lal mirch powder,haldee powder,kacha papita aur adrak lehsan paste dal ker ache tarhan mix karein aur 1 hour kliya marinate ker lein."
    },
    {
      "instruction": "In marinated beef,add water and bring it to boil,cover & cook on low flame until meat is done (Approx. 45 minutes).",
      "romanUrdu": "Marinated beef mein pani dal dein aur ubal anay ka bad dhak dein aur halki ancch per ghost gul janay tak paka lein (Approx. 45 minutes)."
    },
    {
      "instruction": "Add oil,mix well and cook until oil separates.",
      "romanUrdu": "Oil dal ker ache tarhan mix karein aur oil alag hunay tak paka lein."
    },
    {
      "instruction": "Add black pepper crushed and mix well.",
      "romanUrdu": "Kali mirch crushed dal ker ache tarhan mix ker lein."
    },
    {
      "instruction": "Add fresh coriander,green chili and lemon juice,cover & simmer for 2 minutes.",
      "romanUrdu": "Hara dhania,hari mirch aur lemon juice dal ker dhak dein aur 2 minutes kliya dum per rakh dein."
    }
