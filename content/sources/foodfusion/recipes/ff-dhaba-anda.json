  "steps": [
    {
      "instruction": "In frying pan,add oil,onion,tomato and mix well.",
      "romanUrdu": "Frying pan mein oil,pyaz aur tamatar dal ker ache tarhan mix karein."
    },
    {
      "instruction": "Add green chilies and mix.",
      "romanUrdu": "Hari mirchein dal ker mix ker lein."
    },
    {
      "instruction": "Add cumin seeds,coriander powder,red chili powder,turmeric powder,garam masala power,salt,mix & mash well.",
      "romanUrdu": "Zeera,dhania powder,lal mirch powder,haldee powder,garam masala powder aur namak dal ker mix & mash ker lein."
    },
    {
      "instruction": "Add fresh coriander and mix well.",
      "romanUrdu": "Hara dhania dal ker mix karein."
    },
    {
      "instruction": "Add boiled eggs,mix & mash well until well combined.",
      "romanUrdu": "Boiled anday,dal ker ache tarhan mix & mash ker lein."
    },
    {
      "instruction": "Add water,mix well and cook for 2 minutes.",
      "romanUrdu": "Pani dal ker ache tarhan mix karein aur 2 minutes kliya paka lein."
    },
    {
      "instruction": "Add butter,mix well and dish out in a serving dish.",
      "romanUrdu": "Makhan dal ker mix ker lein aur serving dish mein nikal lein."
    },
    {
      "instruction": "In small frying pan,add oil and egg and half fry it.",
      "romanUrdu": "Chotay frying pan mein oil aur anda dal ker half fry (kacha paka anda) ker lein."
    },
    {
      "instruction": "Add this half fry egg over cooked masala egg and mix well.",
      "romanUrdu": "Half fry egg ko cooked masala anda ka upper dal ker ache tarhan mix ker lein."
    },
    {
      "instruction": "In small frying pan,add butter,red chili powder and mix well,pour over cooked masala eggs.",
      "romanUrdu": "Chotay frying pan mein makhan aur lal mirch powder dal ker ache tarhan mix karein aur cooked masala anday ka upper dal dein."
    },
    {
      "instruction": "Add fresh coriander and serve.",
      "romanUrdu": "Hara dhania dal ker serve karein."
    }
  ],
