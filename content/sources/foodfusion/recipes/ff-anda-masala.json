  "steps": [
    {
      "instruction": "In a wok add cooking oil, onion and fry until translucent.",
      "romanUrdu": "Wok may tel garam karen or piaz daal kar halka fry karen."
    },
    {
      "instruction": "Add ginger garlic and mix well until light golden.",
      "romanUrdu": "Ginger garlic paste daal kar milayen or light golden honay tak fry karen."
    },
    {
      "instruction": "Add pureed tomato and mix well.",
      "romanUrdu": "Pureed tamatar daal kar achi tarah milayen."
    },
    {
      "instruction": "Add green chilli and mix well.",
      "romanUrdu": "Hari mirch daal kar milayen."
    },
    {
      "instruction": "Add kashmiri red chilli/paprika powder, coriander powder, black pepper powder, salt, turmeric powder, cumin seeds, dried fenugreek leaves, mix well and cook for 1-2 minutes.",
      "romanUrdu": "Kashmiri laal mirch powder, dhania powder, kali mirch powder, namak, haldi powder, zeera powder, kasuri methi daal kar milayen or 1 se 2 minutes tak pakayen."
    },
    {
      "instruction": "Add water, mix well, cover and cook for 2-3 minutes or until oil separates.",
      "romanUrdu": "Pani daal kar milayen or dhak kar 2 se 3 minutes tak ya tel alag honay tak pakayen."
    },
    {
      "instruction": "Add fresh coriander and mix well.",
      "romanUrdu": "Hara dhania daal kar milayen."
    },
    {
      "instruction": "Add boiled eggs and mix gently.",
      "romanUrdu": "Boil anday daal kar namri se milayen."
    },
    {
      "instruction": "Garnish with green chillies, fresh coriander and serve.",
      "romanUrdu": "Hari mirch or hara dhania daal kar serve karen."
    }
  ],
