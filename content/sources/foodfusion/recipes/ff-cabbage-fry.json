  "steps": [
    {
      "instruction": "In bowl,add cabbage,raw mango,green chillies,onion,fresh coriander and mix well.",
      "romanUrdu": "Bowl mein bund gobhi,kary,hari mirch,pyaz aur hara dhania dal ker ache tarhan mix ker lein."
    },
    {
      "instruction": "Add red chili powder,turmeric powder,coriander powder,salt,gram flour,mix well & set aside.",
      "romanUrdu": "Lal mirch powder,haldee powder,dhania powder,namak aur baisan dal ker ache tarhan mix karein & side per rakh dein."
    },
    {
      "instruction": "In wok,add cooking oil,garlic,button red chillies and mix.",
      "romanUrdu": "Karhai mein cooking oil,lehsan aur sabut lal mirch dal ker mix karein."
    },
    {
      "instruction": "Add cumin seeds,curry leaves and mix well.",
      "romanUrdu": "Zeera aur kari pata dal ker ache tarhan mix ker lein."
    },
    {
      "instruction": "Now add cabbage mixture and mix well.",
      "romanUrdu": "Ab bund gobhi mixture dal ker ache tarhan mix ker lein."
    },
    {
      "instruction": "Cover and cook on low flame for 8-10 minutes.",
      "romanUrdu": "Dhak dein aur halki ancch per 8-10 minutes kliya paka lein."
    },
    {
      "instruction": "Garnish with fresh coriander & serve!",
      "romanUrdu": "Hara dhania sa garnish ker ka serve karein."
    }
  ],
