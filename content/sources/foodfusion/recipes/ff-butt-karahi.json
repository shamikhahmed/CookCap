  "steps": [
    {
      "instruction": "In mortal & pestle,add cumin seeds,coriander seeds,crush coarsely & set aside.",
      "romanUrdu": "Mortal & pestle mein zeera aur sabit dhania dal ker coarsely crush ker lein & side per rakh dein."
    },
    {
      "instruction": "In a cooker,add onion,tomatoes,desi chicken,ginger,garlic,salt,black pepper powder,1/2 tbs of crushed cumin & coriander seeds,water,mix well & bring it to boil,cover and pressure cook for 15 minutes then transfer it to a wok and cook on high flame until water is reduced (approx. 4-5 minutes).",
      "romanUrdu": "Cooker mein pyaz,tamatar,desi murghi,adrak,lehsan,namak,kali mirch powder,1/2 tbs crushed & sabut dhania aur pani dal ker ache tarhan mix karein aur ubal anay ka bad dhak dein aur 15 minutes kliya pressure cook ker lein phir karhai mein dal dein aur tez ancch per pani kum ho janay tak paka lein (approx. 4-5 minutes)."
    },
    {
      "instruction": "Add yogurt and mix well.",
      "romanUrdu": "Dahi dal ker ache tarhan mix ker lein."
    },
    {
      "instruction": "Add cooking oil,remaining quantity of crushed cumin & coriander seeds,red chilli crushed,mix well and cook on high flame until oil separates (2-3 minutes).",
      "romanUrdu": "Cooking oil,baqi bacha huwa crushed zeera & sabut dhania aur lal mirch crushed dal ker ache tarhan mix karein aur tezn ancch per oil alag ho janay tak paka lein (2-3 minutes)."
    },
    {
      "instruction": "Add green chillies and mix well.",
      "romanUrdu": "Hari mirch dal ker mix ker lein."
    },
    {
      "instruction": "Garnish with fresh coriander,ginger,desi ghee & serve!",
      "romanUrdu": "Hara dhania,adrak aur desi ghee sa garnish ker ka serve karein!"
    }
  ],
