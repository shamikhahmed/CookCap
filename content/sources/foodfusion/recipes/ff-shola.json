  "steps": [
    {
      "instruction": "Add beef mince,ginger garlic paste and mix well until mince changes color.",
      "romanUrdu": "Pot mein oil/melted ghee aur pyaz dal ker light brown fry ker lein."
    },
    {
      "instruction": "Add garam masala powder,coriander powder,red chili powder,turmeric powder,mix well and cook for 5 minutes.",
      "romanUrdu": "Beef qeema aur adrak lehsan paste dal ker qeema ka rang tabdeel hunay taka paka lein."
    },
    {
      "instruction": "Add yogurt,spinach,dill,fresh fenugreek leaves,mix well and cook for 3 minutes.",
      "romanUrdu": "Garam masala powder,dhania powder,lal mirch powder aur haldee powder dal ker ache tarhan mix ker lein aur 5 minutes kliya paka lein."
    },
    {
      "instruction": "Add green gram,rice and mix well.",
      "romanUrdu": "Dahi,palak,soya aur hari meethi dal ker ache tarhan mix karein aur 3 minutes kliya paka lein."
    },
    {
      "instruction": "Add salt and mix well.",
      "romanUrdu": "Hari moong daal aur chawal dal ker ache tarhan mix ker lein."
    },
    {
      "instruction": "Add water,mix and bring it to boil,cover and cook on low flame for 30-40 minutes.",
      "romanUrdu": "Namak dal ker ache tarhan mix ker lein."
    },
    {
      "instruction": "Keep mixing & mashing in between,add more water if required,cover and cook for another 10 minutes, mash and cook until desired consistency is achieved.",
      "romanUrdu": "Pail dal ker mix karein aur ubal anay ka bad dhak dein aur halki ancch per 30-40 minutes kliya paka lein."
    },
    {
      "instruction": "Garnish with desi ghee melted,fried onion,green chili,ginger,fresh coriander and lemon juice.",
      "romanUrdu": "Bech bech mein mix & mash kertay rahen,agar zaroorat ho tou mazeed pani daldein aur mazeed 10 minutes kliya paka lein,mash ker lein aur desired consistency anay tak paka lein."
    },
    {
      "instruction": "Desi ghee metled,fried pyaz,hari mirch,adrak,hara dhania aur lemon juice sa garnish karein.",
      "romanUrdu": null
    },
    {
      "instruction": "Garam serve karein.",
      "romanUrdu": null
    }
  ],
