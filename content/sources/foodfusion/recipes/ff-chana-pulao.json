  "steps": [
    {
      "instruction": "In spice mixer,add nutmeg,mace,black peppercorns,black cardamom and grind well.",
      "romanUrdu": "Spice mixer mein jaifil,javatri,sabut kali mirch aur badi elaichi dal ker ache tarhan grind karein."
    },
    {
      "instruction": "Add ginger,garlic,green chilies,water and grind to make a paste & set aside.",
      "romanUrdu": "Adrak,lehsan,hari mirch aur pani dal dein aur grind ker ka paste tayyar ker lein & side per rakh dein."
    },
    {
      "instruction": "In pot,add cooking oil,onion and fry until light golden.",
      "romanUrdu": "Pot mein cooking oil aur pyaz dal dein aur light golden hunay tak fry ker lein."
    },
    {
      "instruction": "Add cumin seeds,cinnamon sticks,black peppercorns,cloves,green cardamom and mix.",
      "romanUrdu": "Zeera,darchini,sabut kali mirch,laung aur hari elaichi dal ker mix karein."
    },
    {
      "instruction": "Now add grinded paste and mix well.",
      "romanUrdu": "Ab grinded paste shamil karein aur ache tarhan mix ker lein."
    },
    {
      "instruction": "Add salt,red chili powder and mix well for 2 minutes.",
      "romanUrdu": "Namak aur lal mirch powder dal ker 2 minutes kliya ache tarhan mix karein."
    },
    {
      "instruction": "Add yogurt and mix well.",
      "romanUrdu": "Dahi shamil karein aur ache tarhan mix ker lein."
    },
    {
      "instruction": "Add chicken stock cube,mint leaves and mix well.",
      "romanUrdu": "Chicken stock cube aur podina dal ker ache tarhan mix karein."
    },
    {
      "instruction": "Add water,mix well and bring it to boil.",
      "romanUrdu": "Pani dal dein aur ubal anay dein."
    },
    {
      "instruction": "Add chickpeas and rice,mix gently and bring it to boil.",
      "romanUrdu": "Chanay aur chawal dal ker gently mix ker lein aur ubal anay dein."
    },
    {
      "instruction": "Cook on medium high flame until water is reduced (8-10 minutes).",
      "romanUrdu": "Darmiyani tez ancch per pani reduce ho janay tak paka lein (8-10 minutes)."
    },
    {
      "instruction": "Cover and steam cook on low flame for 5-8 minutes & serve!",
      "romanUrdu": "Dhak dein aur halki ancch per 5-8 minutes kliya steam cook ker lein & serve karein."
    }
  ],
