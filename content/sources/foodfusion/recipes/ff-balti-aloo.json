  "steps": [
    {
      "instruction": "In wok,add oil,ginger garlic paste,fenugreek seeds,cumin seeds,mustard seeds,nigella seeds,fennel seeds,curry leaves and sauté for a minute.",
      "romanUrdu": "Karhai mein oil aur adrak lehsan paste,methi dana,zeera,rai dana,kalonji,saunf aur kari pata dal ker ek minute kliya saute ker lein."
    },
    {
      "instruction": "Add onion and fry until translucent.",
      "romanUrdu": "Pyaz shamil karein aur translucent hunay tak fry lein."
    },
    {
      "instruction": "Add tomatoes,red chili powder,red chili crushed,turmeric powder and salt,mix well and cook until tomatoes are soft.",
      "romanUrdu": "Tamatar,lal mirch powder,kuti lal mirch,haldee powder aur namak dal ker ache tarhan mix karein aur tamatar naram hunay tak paka lein."
    },
    {
      "instruction": "Now add potatoes, green chili and green coriander,cover and cook on low flame for 15 minutes or until potatoes are tender.",
      "romanUrdu": "Ab is mein aalo,hari mirch aur hara dhania dal ker dhak ker 15 minute kliya halki ancch per ya aalo gul janay tak paka lein."
    },
    {
      "instruction": "Garnish with green coriander.",
      "romanUrdu": "Hara dhania sa garnish karein."
    }
  ],
