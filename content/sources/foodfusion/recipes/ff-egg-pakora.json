  "steps": [
    {
      "instruction": "In a bowl,add eggs & mash well.",
      "romanUrdu": "Bowl mein anday dal ker ache tarhan mash ker lein."
    },
    {
      "instruction": "Add salt,black pepper powder,green chilli,cheddar cheese,mozzarella cheese,mash well & set aside.",
      "romanUrdu": "Namak,kali mirch powder,hari mirch,cheddar cheese aur mozzarella cheese dal ker ache tarhan mash karein & side per rakh dein."
    },
    {
      "instruction": "In a bowl,add gram flour,red chilli powder,salt,cumin seeds,baking soda,turmeric powder,chaat masala, garam masala powder,carom seeds,yellow food color and ginger garlic paste.",
      "romanUrdu": "Bowl mein baisan,lal mirch powder,namak,zeera,baking soda,halee powder,chaat masala,garam masala powder,ajwain,yellow food color aur adrak lehsan paste dal dein."
    },
    {
      "instruction": "Gradually add water and whisk well until thick batter is formed.",
      "romanUrdu": "Thora thora ker pani shamil karein aur thick batter bannay tak ache tarhan whisk ker lein."
    },
    {
      "instruction": "Cover & let it rest for 15 minutes.",
      "romanUrdu": "Dhak dein aur 15 minutes kliya rakh dein."
    },
    {
      "instruction": "Take a mixture and make balls of equal sizes then dip into prepared batter.",
      "romanUrdu": "Mixture ko lein aur ek jaisay sizes ki balls tayyar ker lein phir tayyar batter mein dip ker lein."
    },
    {
      "instruction": "In a wok,add cooking oil,heat it and fry egg pakora on medium flame until golden brown.",
      "romanUrdu": "Karhai mein cooking oil dal ker garam karein aur egg pakora ko darmiyani ancch per golden brown hunay tak fry ker lein."
    },
    {
      "instruction": "Sprinkle chaat masala & serve with green chutney.",
      "romanUrdu": "Chaat masala dal ker hari chutney ka saath serve karein!"
    }
  ],
