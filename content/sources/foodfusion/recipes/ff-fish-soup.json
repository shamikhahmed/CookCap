  "steps": [
    {
      "instruction": "Clean and remove center bone.",
      "romanUrdu": "Fish ko saaf ker ka center bone ko nikal lein."
    },
    {
      "instruction": "In small fish,add salt and turmeric powder,mix well and set aside for 30 minutes then wash with tap water.",
      "romanUrdu": "Chirchiri machli mein namak aur haldee powder dal ker ache tarhan mix karein aur 30 minutes kliya side per rakh dein phir tap water sa wash ker lein."
    },
    {
      "instruction": "In pot,add olive oil,onion and fry until translucent.",
      "romanUrdu": "Pot mein olive oil aur pyaz dal dein aur translucent hunay tak fry ker lein."
    },
    {
      "instruction": "Add ginger,garlic and mix well.",
      "romanUrdu": "Adrak aur lehsan dal ker ache tarhan mix ker lein."
    },
    {
      "instruction": "Add tomato paste and cook for 2 minutes.",
      "romanUrdu": "Tomato paste dal dein aur 2 minutes kliya paka lein."
    },
    {
      "instruction": "Add carrots,cabbage,salt and black pepper crushed and mix well.",
      "romanUrdu": "Gajar,bund gobhi,namak,kali mirch crushed dal ker ache tarhan mix karein."
    },
    {
      "instruction": "Add washed fish and mix well.",
      "romanUrdu": "Washed machli dal dein aur ache tarhan mix ker lein."
    },
    {
      "instruction": "Add water,mix well and bring it to boil,cover & cook on low flame for approx.1 hour.",
      "romanUrdu": "Pani shamil ker ka mix karein aur ubal anay ka bad dhak dein & halki ancch per approx. 1 hour kliya paka lein."
    },
    {
      "instruction": "Add green onion,mix well & serve.",
      "romanUrdu": "Hara pyaz dal ker ache tarhan mix karein & serve karein."
    }
  ],
