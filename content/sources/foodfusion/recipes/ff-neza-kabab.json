  "steps": [
    {
      "instruction": "In beef mince,add turmeric powder,red chili powder,salt,garlic,ginger,onion,green chili,fresh coriander, butter and mix well,cover and let it marinate for 15-20 minutes in freezer.",
      "romanUrdu": "Beef qeema mein haldee powder,lal mirch powder,namak,lehsan,adrak,pyaz,hari mirch,hara dhania aur makhan dal ker ache tarhan mix karein aur dhak ker 15-20 minutes kliya freezer mein rakh dein."
    },
    {
      "instruction": "Take a mixture and make 15 kebabs of equal sizes.",
      "romanUrdu": "Mixture ka ek jaisay size ka 15 kebabs bana lein."
    },
    {
      "instruction": "In frying pan,heat oil and fry kebabs until brown & set aside.",
      "romanUrdu": "Frying pan mein oil garam karein aur kebab ko brown hunay tak fry ker lein aur side per rakh dein."
    },
    {
      "instruction": "In blender,add green chilies,yogurt,fresh coriander and mint leaves,blend to form a paste and set aside.",
      "romanUrdu": "Blender mein hari mirchein,dahi,hara dhania aur podina dal dein aur blend ker ka paste tayyar ker lein aur side per rakh dein."
    },
    {
      "instruction": "In pot,add oil,ginger garlic,cumin seeds and mix well.",
      "romanUrdu": "Pot mein oil,adrak,lehsan aur zeera dal ker ache tarhan mix ker lein."
    },
    {
      "instruction": "Add green chili,ginger and mix well.",
      "romanUrdu": "Hari mirch aur adrak dal ker mix ker lein."
    },
    {
      "instruction": "Add onion,mix well and cook for 2 minutes.",
      "romanUrdu": "Pyaz dal ker ache tarhan mix karein aur 2 minutes kliya paka lein."
    },
    {
      "instruction": "Add salt,mix well and cook until light brown.",
      "romanUrdu": "Namak dal ker mix karein aur light brown hunay tak paka lein."
    },
    {
      "instruction": "Add yogurt,mix well and cook on high flame for 4-5 minutes.",
      "romanUrdu": "Dahi dal ker ache tarhan mix karein aur tez ancch per 4-5 minutes kliya paka lein."
    },
    {
      "instruction": "Add blended green paste and mix well.",
      "romanUrdu": "Blended green paste dal ker ache tarhan mix ker lein."
    },
    {
      "instruction": "Add water,mix well and cook for 2-3 minutes.",
      "romanUrdu": "Pani dal ker mix karein aur 2-3 minutes kliya paka lein."
    },
    {
      "instruction": "Add fried kebabs and stir gently.",
      "romanUrdu": "Fried kebabs dal ker gently stir ker lein."
    },
    {
      "instruction": "Add water and mix,cover and cook for 2-3 minutes.",
      "romanUrdu": "Pani dal ker mix karein aur dhak ker 2-3 minutes kliya paka lein."
    },
    {
      "instruction": "Give a coal smoke for 2 minutes.",
      "romanUrdu": "2 minutes kliya koyla ka dhuwan dein."
    },
    {
      "instruction": "Garnish with cream & serve.",
      "romanUrdu": "Cream sa garnish ker ka serve karein."
    }
  ],
